{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "existingSecret": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
      "maxLength": 253,
      "minLength": 1
    },
    "telegram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedUserIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        }
      },
      "required": [
        "allowedUserIds"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentServiceIP": {
          "$ref": "#/definitions/privateIPv4"
        },
        "mcpServiceIP": {
          "$ref": "#/definitions/privateIPv4"
        },
        "dnsIP": {
          "$ref": "#/definitions/privateIPv4"
        },
        "clusterCIDRs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "clusterDomain": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253,
          "minLength": 1
        },
        "dnsNamespaceLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "dnsPodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "agentServiceIP",
        "mcpServiceIP",
        "dnsIP",
        "clusterCIDRs",
        "clusterDomain",
        "dnsNamespaceLabels",
        "dnsPodLabels"
      ]
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/definitions/image"
        },
        "mcp": {
          "$ref": "#/definitions/image"
        },
        "google": {
          "$ref": "#/definitions/image"
        },
        "telegram": {
          "$ref": "#/definitions/image"
        },
        "worker": {
          "$ref": "#/definitions/image"
        },
        "postgres": {
          "$ref": "#/definitions/image"
        },
        "objects": {
          "$ref": "#/definitions/image"
        }
      },
      "required": [
        "agent",
        "mcp",
        "google",
        "telegram",
        "worker",
        "postgres",
        "objects"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "autoCompactPercent": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                ""
              ]
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          ]
        },
        "subagentModel": {
          "type": "string",
          "minLength": 1
        },
        "subagentReasoningEffort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "subagentMaxThreads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "turnTimeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "inputMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000000
            },
            "outputMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50000000
            },
            "imageMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "capacityBytes": {
              "type": "integer",
              "minimum": 1
            },
            "stagingSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "retentionSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "sweepSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "maxFiles",
            "inputMaxBytes",
            "outputMaxBytes",
            "imageMaxBytes",
            "capacityBytes",
            "stagingSeconds",
            "retentionSeconds",
            "sweepSeconds"
          ]
        }
      },
      "required": [
        "model",
        "reasoningEffort",
        "autoCompactPercent",
        "subagentModel",
        "subagentReasoningEffort",
        "subagentMaxThreads",
        "turnTimeoutSeconds",
        "artifacts"
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retentionSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "sweepSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "retentionSeconds",
        "sweepSeconds",
        "maxBytes"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClassName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "sizes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgres": {
              "$ref": "#/definitions/quantity"
            },
            "artifacts": {
              "$ref": "#/definitions/quantity"
            },
            "google": {
              "$ref": "#/definitions/quantity"
            },
            "native": {
              "$ref": "#/definitions/quantity"
            },
            "workspace": {
              "$ref": "#/definitions/quantity"
            },
            "saved": {
              "$ref": "#/definitions/quantity"
            },
            "state": {
              "$ref": "#/definitions/quantity"
            },
            "objects": {
              "$ref": "#/definitions/quantity"
            }
          },
          "required": [
            "postgres",
            "artifacts",
            "google",
            "native",
            "workspace",
            "saved",
            "state",
            "objects"
          ]
        },
        "existingClaims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgres": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "artifacts": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "google": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "native": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "workspace": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "saved": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "state": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "objects": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            }
          },
          "required": [
            "postgres",
            "artifacts",
            "google",
            "native",
            "workspace",
            "saved",
            "state",
            "objects"
          ]
        },
        "legacyClaim": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        }
      },
      "required": [
        "storageClassName",
        "sizes",
        "existingClaims",
        "legacyClaim"
      ]
    },
    "instructionsConfigMap": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
      "maxLength": 253
    },
    "google": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oauthEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "oauthEnabled"
      ]
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "$ref": "#/definitions/resources"
        },
        "agent": {
          "$ref": "#/definitions/resources"
        },
        "mcp": {
          "$ref": "#/definitions/resources"
        },
        "google": {
          "$ref": "#/definitions/resources"
        },
        "telegram": {
          "$ref": "#/definitions/resources"
        },
        "worker": {
          "$ref": "#/definitions/resources"
        },
        "objects": {
          "$ref": "#/definitions/resources"
        },
        "test-console": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "postgres",
        "agent",
        "mcp",
        "google",
        "telegram",
        "worker",
        "objects",
        "test-console"
      ]
    }
  },
  "required": [
    "existingSecret",
    "telegram",
    "network",
    "images",
    "agent",
    "worker",
    "storage",
    "instructionsConfigMap",
    "google",
    "objects",
    "console",
    "resources"
  ],
  "definitions": {
    "quantity": {
      "type": "string",
      "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(m|Ki|Mi|Gi|Ti|Pi)?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "privateIPv4": {
      "type": "string",
      "format": "ipv4",
      "pattern": "^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)"
    }
  }
}
