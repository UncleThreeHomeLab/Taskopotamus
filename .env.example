TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Persistent service data; each service mounts only its own subfolder.
# First setup: python -m src.storage.prepare --data-dir ./storage --credentials-dir ./credentials
DATA_DIR=./storage
# Preparation adjusts permissions only inside this directory. Custom secret paths need equivalent service-readable permissions.
CREDENTIALS_DIR=./credentials
# Optional: change if this subnet overlaps your local network.
TASKOPOTAMUS_SUBNET=10.203.17.0/28
TASKOPOTAMUS_EXECUTION_SUBNET=10.203.17.16/28
# Must belong to TASKOPOTAMUS_EXECUTION_SUBNET; permits only MCP HTTP through the worker firewall.
WORKER_MCP_IP=10.203.17.18
# Worker permits DNS only to this resolver, using TCP/UDP port 53.
WORKER_DNS_IP=1.1.1.1
TASKOPOTAMUS_DATABASE_SUBNET=10.203.17.32/28
TASKOPOTAMUS_OBJECT_SUBNET=10.203.17.48/28
CODEX_MODEL=gpt-6-astra
CODEX_REASONING_EFFORT=medium
# Explicit child defaults; never inherit the main model implicitly. Maximum depth is one.
CODEX_SUBAGENT_MODEL=gpt-6-luna
CODEX_SUBAGENT_REASONING_EFFORT=high
CODEX_SUBAGENT_MAX_THREADS=2
CODEX_TURN_TIMEOUT_SECONDS=600
# Leave blank for model-specific compaction defaults, including subagents.
# Optional override: integer percentage of each thread's runtime context window.
# Until the runtime reports a window, Codex defaults apply.
CODEX_AUTO_COMPACT_PERCENT=
# Path to a private file containing a random service token of at least 32 ASCII characters.
AGENT_API_TOKEN_PATH=
# Separate random signing key (at least 32 ASCII characters) shared only by agent and MCP.
PROFILE_SIGNING_KEY_PATH=
# Owner-managed system_instructions.md; edits apply on the next message.
AGENT_INSTRUCTIONS_DIR=./config/agent
# Generated by the preparation command; files are never overwritten. Blank path overrides use CREDENTIALS_DIR.
POSTGRES_ADMIN_PASSWORD_PATH=
AGENT_DATABASE_PASSWORD_PATH=
PROFILE_DATABASE_PASSWORD_PATH=
TELEGRAM_DATABASE_PASSWORD_PATH=
SILO_ROOT_PASSWORD_PATH=
# Silo is private infrastructure reserved for future attachments; no app receives its admin credentials.
